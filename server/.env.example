# Puerto del servidor
PORT=5000

# development o production (en production la cookie usa secure)
NODE_ENV=development

# Cadena de conexión de MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/chroniccare

# Clave para firmar los JWT. Usa una clave larga y aleatoria
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
